# InferenceOps environment variables.
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is the template.

# --- Model storage ---
# Local filesystem path to model artifacts (used when MODEL_STORAGE_BACKEND=local).
MODEL_PATH=./models/artifacts
# Storage backend: "local" or "s3".
MODEL_STORAGE_BACKEND=local

# --- S3 / object storage (used when MODEL_STORAGE_BACKEND=s3) ---
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_REGION=us-east-1

# --- Serving / auth ---
# API key for authenticating gateway/model-server requests.
API_KEY=
# LLM backend selector for the LLM serving path (e.g. "vllm", "mock").
LLM_BACKEND=

# --- Observability ---
# OpenTelemetry collector OTLP endpoint.
OTEL_ENDPOINT=
# Prometheus scrape/query endpoint.
PROMETHEUS_URL=

# --- Docker (rootless on a custom per-user socket) ---
DOCKER_HOST=unix:///run/user/1000/docker-me.sock
