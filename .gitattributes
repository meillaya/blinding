# GitHub's language bar counts a language by the tracked bytes that Linguist
# detects. The shell wrappers under scripts/ are tooling around the Python
# package, so keep them out of that count.
*.sh linguist-detectable=false

# Results are text data; keep one line ending on every host.
*.csv text eol=lf

# Run records under results/ are generated artifacts, not source.
results/** linguist-generated=true
