# Environment
.env
.venv/
.devenv*/

# Python
__pycache__/
*.pyc
.coverage
coverage.json
htmlcov/
dist/

# Terraform
*.tfstate*
.terraform/

# Model artifacts (binary blobs, not their READMEs)
models/artifacts/**/*.pkl

# Tooling caches
.codegraph
.codegraph/
.omx/

# Orchestration / agent workflow state (not part of the deliverable)
.omo/

# Terraform provider lock files (regenerated by `terraform init`)
.terraform.lock.hcl

# Generated load-test / eval / batch artifacts.
# (baseline.json and benchmark.md / benchmark.json are committed deliverables
#  and remain tracked — the patterns below deliberately do not match them.)
evals/reports/eval_*.json
evals/reports/k6-*.json
evals/reports/locust*
evals/reports/batch_*
