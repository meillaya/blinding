# Build-context exclusions for the gateway image.
#
# The build context is the REPO ROOT (so the Dockerfile can see the uv workspace
# metadata). Exclude everything the image does NOT need — critically the large
# virtualenvs (.venv ~758M, .devenv ~724M) and VCS/tooling dirs — while keeping
# the files the Dockerfile COPYs:
#   pyproject.toml, uv.lock, apps/{gateway,model-server,worker}/pyproject.toml,
#   apps/gateway/src/
# (The gateway ships no model artifact, so models/ is excluded too.)

# Version control
.git
.gitignore

# Python virtualenvs / devenv toolchain (LARGE — must exclude)
.venv
.devenv
.devenv*
devenv.lock
devenv.nix
devenv.yaml

# Bytecode / caches (anywhere)
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd

# Test / lint / type-check / coverage artifacts
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
.coverage.*
htmlcov
coverage.xml
dist
build
**/*.egg-info
**/tests

# Environment / secrets
.env
.env.*

# Terraform
.terraform
**/*.tfstate
**/*.tfstate.*

# Agent / indexing / tooling dirs
.omo
.omx
.codegraph
.codegraph/*
/tmp

# IDE / OS
.idea
.vscode
**/.DS_Store

# Top-level dirs not needed inside the image
docs
evals
infra
k8s
load_tests
models
observability
scripts
serving
tests
README.md
LICENSE
Makefile
