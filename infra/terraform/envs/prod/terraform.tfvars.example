# Example variable values for the prod environment. Copy to terraform.tfvars and
# adjust. With NO tfvars file the defaults still plan OFFLINE (offline_plan=true)
# — but a real prod deploy uses the real-AWS path below, with credentials.

environment = "prod"
region      = "us-east-1"

# REAL-AWS path for prod: removes the moto endpoints/skips, restores IRSA/OIDC,
# real AMI resolution and the core EKS addons. Requires credentials
# (AWS_PROFILE / IRSA / env keys). `terraform plan` with offline_plan=false and
# NO credentials fails auth — that failure is the guard proving this is the
# real-AWS code path.
offline_plan = false

# Prod runs the GPU node group (g5.xlarge, tainted nvidia.com/gpu=present:NoSchedule).
enable_gpu_node_group = true

# kubernetes_version = "1.33"
# enable_karpenter   = false
# alarm_email        = "oncall@example.com"
