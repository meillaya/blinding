# Example variable values for the staging environment. Copy to terraform.tfvars
# and adjust. With NO tfvars file the defaults already plan OFFLINE
# (offline_plan=true, no AWS credentials needed — just start scripts/tf_mock.sh).

environment = "staging"
region      = "us-east-1"

# OFFLINE mock mode: plan against the local moto server (scripts/tf_mock.sh).
# Set false for the real-AWS path (requires credentials; enables IRSA/OIDC,
# real AMI resolution and the core EKS addons).
offline_plan = true

# kubernetes_version    = "1.33"
# enable_gpu_node_group = false
# enable_karpenter      = false
# alarm_email           = "oncall@example.com"
