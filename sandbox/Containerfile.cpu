# CPU image. The llama.cpp commit is the one this host already runs, so the
# benchmark compares like with like.
FROM docker.io/library/python:3.12-slim-bookworm@sha256:0f086103b026048cc50cb5da25ec435c023c5241a83fc44daea593377abc61c4

ARG LLAMA_CPP_TAG=b10964
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch "${LLAMA_CPP_TAG}" \
        https://github.com/ggml-org/llama.cpp /opt/llama.cpp

RUN cmake -S /opt/llama.cpp -B /opt/llama.cpp/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DLLAMA_BUILD_TESTS=OFF \
        -DLLAMA_BUILD_EXAMPLES=ON \
        -DLLAMA_BUILD_SERVER=ON \
        -DLLAMA_CURL=OFF \
    && cmake --build /opt/llama.cpp/build --parallel "$(nproc)" \
    && cmake --install /opt/llama.cpp/build \
    && ldconfig

RUN pip install --no-cache-dir uv==0.13.7

ENV PATH="/usr/local/bin:${PATH}"
WORKDIR /work
